# ─── TrustBond Environment Variables ───────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── XRPL Network ───────────────────────────────────────
# Testnet (default for development)
XRPL_WSS_URL=wss://s.altnet.rippletest.net:51233

# Mainnet (production — use only after full testing)
# XRPL_WSS_URL=wss://xrplcluster.com

# ── NGO Issuer Wallet ───────────────────────────────────
# The NGO account that issues EDU impact tokens
NGO_ADDRESS=rJk8icF7rHEVuRp7qUFJupf1iJQ9G7U95g
NGO_SEED=your_ngo_seed_here

# ── Donor Wallet ────────────────────────────────────────
# The donor account that sends XRP and receives EDU tokens
DONOR_ADDRESS=rQ9s6NopNCVCDGjkA27wjce6sKh81Mx6fi
DONOR_SEED=your_donor_seed_here

# ── Token Configuration ─────────────────────────────────
# Currency code for the impact token (3 chars or 20-char hex)
TOKEN_CURRENCY=EDU

# Exchange rate: how many tokens issued per 1 XRP donated
TOKEN_RATE=1

# Maximum EDU a single donor trustline can hold
TRUSTLINE_LIMIT=100000

# ── App Configuration ───────────────────────────────────
# Port for any future backend server
PORT=3000

# Environment (development | production)
NODE_ENV=development
